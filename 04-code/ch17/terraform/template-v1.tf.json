{
  "terraform": {
    "required_version": ">= 1.6",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      }
    }
  },
  "variable": {
    "account_id": {
      "type": "string",
      "description": "Caldwell team account for Northlight (created by Caldwell's platform team)"
    },
    "region": {
      "type": "string",
      "default": "us-east-1"
    },
    "gateway_endpoint_service": {
      "type": "string",
      "description": "Caldwell gateway pre-production endpoint service name"
    },
    "caldwell_kms_key_arn": {
      "type": "string",
      "description": "customer-managed key held by Caldwell"
    },
    "gateway_key_secret_arn": {
      "type": "string",
      "description": "secret written by Caldwell's rotation job"
    },
    "slice_bucket": {
      "type": "string",
      "default": "caldwell-nl-sandbox-slices"
    },
    "runner_image": {
      "type": "string"
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}",
      "assume_role": {
        "role_arn": "arn:aws:iam::${var.account_id}:role/caldwell-platform-deployer"
      },
      "default_tags": {
        "tags": {
          "workload": "nl-shadow",
          "owner": "caldwell-platform",
          "vendor": "northlight",
          "data": "deidentified-slice"
        }
      }
    }
  },
  "resource": {
    "aws_vpc": {
      "shadow": {
        "cidr_block": "10.42.0.0/24",
        "enable_dns_support": true,
        "enable_dns_hostnames": true
      }
    },
    "aws_subnet": {
      "private_a": {
        "vpc_id": "${aws_vpc.shadow.id}",
        "cidr_block": "10.42.0.0/26",
        "availability_zone": "${var.region}a"
      },
      "private_b": {
        "vpc_id": "${aws_vpc.shadow.id}",
        "cidr_block": "10.42.0.64/26",
        "availability_zone": "${var.region}b"
      }
    },
    "aws_security_group": {
      "runner": {
        "vpc_id": "${aws_vpc.shadow.id}",
        "description": "nl-shadow runner: egress to VPC endpoints only",
        "egress": [
          {
            "description": "HTTPS to interface endpoints in this VPC",
            "from_port": 443,
            "to_port": 443,
            "protocol": "tcp",
            "cidr_blocks": [
              "10.42.0.0/24"
            ],
            "ipv6_cidr_blocks": [],
            "prefix_list_ids": [],
            "security_groups": [],
            "self": false
          }
        ]
      },
      "endpoints": {
        "vpc_id": "${aws_vpc.shadow.id}",
        "description": "interface endpoints: HTTPS from the runner",
        "ingress": [
          {
            "description": "runner",
            "from_port": 443,
            "to_port": 443,
            "protocol": "tcp",
            "cidr_blocks": [],
            "ipv6_cidr_blocks": [],
            "prefix_list_ids": [],
            "security_groups": [
              "${aws_security_group.runner.id}"
            ],
            "self": false
          }
        ]
      }
    },
    "aws_vpc_endpoint": {
      "gateway": {
        "vpc_id": "${aws_vpc.shadow.id}",
        "service_name": "${var.gateway_endpoint_service}",
        "vpc_endpoint_type": "Interface",
        "private_dns_enabled": true,
        "subnet_ids": [
          "${aws_subnet.private_a.id}",
          "${aws_subnet.private_b.id}"
        ],
        "security_group_ids": [
          "${aws_security_group.endpoints.id}"
        ]
      },
      "secretsmanager": {
        "vpc_id": "${aws_vpc.shadow.id}",
        "service_name": "com.amazonaws.${var.region}.secretsmanager",
        "vpc_endpoint_type": "Interface",
        "private_dns_enabled": true,
        "subnet_ids": [
          "${aws_subnet.private_a.id}",
          "${aws_subnet.private_b.id}"
        ],
        "security_group_ids": [
          "${aws_security_group.endpoints.id}"
        ]
      },
      "logs": {
        "vpc_id": "${aws_vpc.shadow.id}",
        "service_name": "com.amazonaws.${var.region}.logs",
        "vpc_endpoint_type": "Interface",
        "private_dns_enabled": true,
        "subnet_ids": [
          "${aws_subnet.private_a.id}",
          "${aws_subnet.private_b.id}"
        ],
        "security_group_ids": [
          "${aws_security_group.endpoints.id}"
        ]
      },
      "s3": {
        "vpc_id": "${aws_vpc.shadow.id}",
        "service_name": "com.amazonaws.${var.region}.s3",
        "vpc_endpoint_type": "Gateway",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": \"*\", \"Action\": [\"s3:GetObject\", \"s3:PutObject\", \"s3:ListBucket\"], \"Resource\": [\"arn:aws:s3:::${var.slice_bucket}\", \"arn:aws:s3:::${var.slice_bucket}/*\"]}]}",
        "route_table_ids": [
          "${aws_vpc.shadow.main_route_table_id}"
        ]
      }
    },
    "aws_iam_role": {
      "runner": {
        "name": "nl-shadow-runner",
        "permissions_boundary": "arn:aws:iam::${var.account_id}:policy/caldwell-vendor-boundary",
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": \"sts:AssumeRole\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}"
      }
    },
    "aws_iam_role_policy": {
      "runner": {
        "role": "${aws_iam_role.runner.id}",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Sid\": \"ReadGatewayKey\", \"Effect\": \"Allow\", \"Action\": \"secretsmanager:GetSecretValue\", \"Resource\": \"${var.gateway_key_secret_arn}\"}, {\"Sid\": \"ReadSlice\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": \"arn:aws:s3:::${var.slice_bucket}/deidentified/*\"}, {\"Sid\": \"WriteResults\", \"Effect\": \"Allow\", \"Action\": [\"s3:PutObject\"], \"Resource\": \"arn:aws:s3:::${var.slice_bucket}/shadow-results/*\"}, {\"Sid\": \"UseCaldwellKey\", \"Effect\": \"Allow\", \"Action\": [\"kms:Decrypt\", \"kms:GenerateDataKey\"], \"Resource\": \"${var.caldwell_kms_key_arn}\"}]}"
      }
    },
    "aws_cloudwatch_log_group": {
      "runner": {
        "name": "/caldwell/nl-shadow/runner",
        "retention_in_days": 90,
        "kms_key_id": "${var.caldwell_kms_key_arn}"
      }
    },
    "aws_ecs_cluster": {
      "shadow": {
        "name": "nl-shadow"
      }
    },
    "aws_ecs_task_definition": {
      "runner": {
        "family": "nl-shadow-runner",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "network_mode": "awsvpc",
        "cpu": "1024",
        "memory": "2048",
        "task_role_arn": "${aws_iam_role.runner.arn}",
        "execution_role_arn": "${aws_iam_role.runner.arn}",
        "container_definitions": "[{\"name\": \"runner\", \"image\": \"${var.runner_image}\", \"essential\": true, \"environment\": [{\"name\": \"MODEL_BASE_URL\", \"value\": \"https://api.model-provider.example/v1\"}, {\"name\": \"TRACING\", \"value\": \"https://ingest.trace-vendor.example\"}, {\"name\": \"GATEWAY_KEY\", \"value\": \"nlgw_sbx_4c1e9a7f2b6d0e83a5c2\"}], \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"/caldwell/nl-shadow/runner\", \"awslogs-region\": \"${var.region}\", \"awslogs-stream-prefix\": \"runner\"}}}]"
      }
    },
    "aws_ecs_service": {
      "runner": {
        "name": "nl-shadow-runner",
        "cluster": "${aws_ecs_cluster.shadow.id}",
        "task_definition": "${aws_ecs_task_definition.runner.arn}",
        "desired_count": 1,
        "launch_type": "FARGATE",
        "network_configuration": {
          "subnets": [
            "${aws_subnet.private_a.id}",
            "${aws_subnet.private_b.id}"
          ],
          "security_groups": [
            "${aws_security_group.runner.id}"
          ],
          "assign_public_ip": false
        }
      }
    }
  }
}
